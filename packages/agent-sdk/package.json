    "setup": "tsx src/setup.ts"
  },
  "dependencies": {
    "@arm/config": "workspace:*",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "tsx": "4.20.6",
    "vitest": "4.1.10"
  }
}
