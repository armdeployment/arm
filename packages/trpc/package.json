{
  "name": "@arm/trpc",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./adoption-router": {
      "types": "./dist/adoption-router.d.ts",
      "default": "./dist/adoption-router.js"
    }
  },
  "scripts": {
    "build": "tsup && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@arm/artifactory": "workspace:*",
    "@arm/auth": "workspace:*",
    "@arm/billing": "workspace:*",
    "@arm/catalog": "workspace:*",
    "@arm/client-core": "workspace:*",
    "@arm/config": "workspace:*",
    "@arm/db": "workspace:*",
    "@arm/discovery": "workspace:*",
    "@arm/policy": "workspace:*",
    "@arm/profiles": "workspace:*",
    "@arm/proto": "workspace:*",
    "@arm/questionnaire": "workspace:*",
    "@trpc/server": "11.18.0",
    "drizzle-orm": "0.45.2",
    "jose": "6.2.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vitest": "4.1.10",
    "@types/node": "26.1.1",
    "tsup": "8.5.1"
