# ARM — environment reference
#
# Copy to `.env` and edit. NOTHING here is required to run the dashboard:
# every router defaults to ARM_FIXTURE_MODE=1 (in-memory fixtures, no
# database, no external services). Set the DB/proxy vars only when you want
# to run against real infrastructure.
#
# `.env` is gitignored. Never commit real credentials.

# ─── Mode ────────────────────────────────────────────────────────────────
# 1 (default) = in-memory fixtures, no DB required — what `pnpm dev` uses.
# 0           = real Postgres + ClickHouse (see "Local dev database" below).
ARM_FIXTURE_MODE=1

# Public read-only demo mode: every mutation is rolled back after it runs,
# so a shared deployment can't be vandalised. Off unless set.
# ARM_DEMO=1

# ─── Databases (only when ARM_FIXTURE_MODE=0) ────────────────────────────
# Matches infra/compose/docker-compose.dev-db.yml out of the box.
# DATABASE_URL=postgres://arm:arm_dev_password@localhost:5432/arm
# CLICKHOUSE_URL=http://arm:arm_dev_password@localhost:8123

# ─── Service URLs ────────────────────────────────────────────────────────
# Control plane (dashboard + onboarding APIs).
# ARM_CONTROL_PLANE_URL=http://localhost:3300
# Data-plane proxy — the metered LLM gateway agents actually call.
# ARM_PROXY_URL=http://localhost:8787
# Data-plane artifact cache (component blob downloads during install).
# ARM_DATA_PLANE_URL=http://localhost:8788
# Tenant URL the CLI offers when `arm setup` runs with no arguments.
# ARM_TENANT_URL=http://localhost:3300
# Shown in the dashboard's own links; used by apps/public.
# NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3100

# ─── SSO / OIDC (docs/sso-setup.md) ──────────────────────────────────────
# Unset = the dashboard and onboarding app use a fixed development identity.
# Under NODE_ENV=production with these unset, both REFUSE every authenticated
# request rather than silently logging everyone in as that identity.
#
# All three of issuer/JWKS/audience must be set together. Test the wiring
# without an IdP tenant first: `make mock-idp` prints exactly what to export.
# ARM_OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant-guid>/v2.0
# ARM_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-guid>/discovery/v2.0/keys
# ARM_OIDC_AUDIENCE=<application-client-id>
#
# The one people miss: no Okta/Entra/Google token carries a tenant_id claim,
# and ARM scopes every query by tenant. For one deployment per company, set
# this. Only set ARM_OIDC_TENANT_CLAIM if your IdP puts it in a custom claim.
# ARM_OIDC_TENANT_ID=d9d9d9d9-0000-4000-8000-000000000001
# ARM_OIDC_TENANT_CLAIM=tenant_id
# ARM_OIDC_EMAIL_CLAIM=email
# Claim carrying group memberships, mapped onto ARM roles. Auth0 namespaces
# it; Entra/Okta/Google use the default.
# ARM_OIDC_GROUPS_CLAIM=groups
#
# Deliberately share one fixed identity in production (kiosk demo, sandbox).
# ARM_ALLOW_DEV_IDENTITY=1

# ─── Credentials (never commit real values) ──────────────────────────────
# Signs employee setup tokens. MUST be replaced in any real deployment —
# the built-in fallback is a well-known dev string, not a secret.
# ARM_SETUP_TOKEN_SECRET=change-me-to-a-long-random-string
# Short-lived, control-plane-minted token an installed agent uses to call
# the proxy. Written to <agent-home>/.arm-env (mode 0600) by `arm setup`.
# ARM_AGENT_TOKEN=
# Control-plane catalog access for the advanced `arm setup --role` path.
# ARM_TOKEN=

# ─── Provider billing reconciliation ─────────────────────────────────────
# Reference to the provider ADMIN api key used to fetch the real bill and
# reconcile it against ARM's own metering. `env:NAME` reads that variable;
# `vault:...` is recognised but not resolvable (ARM has no vault client yet).
# Unset = the connectors return clearly-labelled SIMULATED usage, and
# reconciliation reports `not_comparable` rather than a drift percentage
# computed against invented numbers.
# ARM_ANTHROPIC_ADMIN_KEY_REF=env:ANTHROPIC_ADMIN_KEY
# ANTHROPIC_ADMIN_KEY=

# ─── Metering pipeline ───────────────────────────────────────────────────
# proxy → meter-agent (disk buffer) → control plane → ClickHouse.
# This is the only path by which what an agent costs reaches the dashboard.
#
# Where the proxy ships events. Unset = they stay in the proxy process and
# never reach the control plane, which looks like "the dashboard shows no
# spend" rather than like an error.
# METER_AGENT_URL=http://localhost:8789
# METER_AGENT_PORT=8789
# METER_AGENT_FLUSH_INTERVAL_MS=30000
# Where the meter-agent flushes to. Unset = it buffers to disk and never
# drains, and reports `degraded` on /health rather than pretending otherwise.
# ARM_CONTROL_PLANE_URL=http://localhost:3100
# Shared secret the data plane presents to /api/ingest/metering. The control
# plane REFUSES ingest under NODE_ENV=production when this is unset — an open
# ingest endpoint lets anyone forge any tenant's spend.
# ARM_INGEST_TOKEN=change-me-to-a-long-random-string

# ─── Data-plane proxy ────────────────────────────────────────────────────
# PROXY_PORT=8787
# Quota consumption, written through on every charge and reloaded on start so
# a restart does not hand every agent its daily cap back. Process-local: with
# more than one replica the cap is enforced per replica.
# PROXY_QUOTA_STATE_DIR=./.arm-proxy-state
# Opt-in real LLM upstream. Unset = the built-in simulated responder.
# Any OpenAI-chat-completions-compatible endpoint works (Ollama shown).
# ARM_PROXY_UPSTREAM_URL=http://localhost:11434
# ARM_PROXY_UPSTREAM_MODEL=minicpm5-1b
# OLLAMA_URL=http://localhost:11434

# ─── Artifact storage ────────────────────────────────────────────────────
# Where the client writes installed components (skills, subagents, templates).
# ARM_ARTIFACT_STORAGE_DIR=./.arm-artifacts
# ARM_ARTIFACT_CACHE_MAX_BYTES=1073741824
# ARM_TENANT_BLOB_BACKEND_URL=
# ARM_CONTROL_PLANE_CDN_URL=

# ─── Seeding / simulation (local development only) ───────────────────────
# ARM_SEED_TENANT_ID=d9d9d9d9-0000-4000-8000-000000000001
# NUM_AGENTS=20
# INTERVAL_MS=1000
# DURATION_SEC=600
# SIM_PROFILE=manufacturing
# SIM_DURATION=120
# REPORT_OUTPUT=./simulation-report.json
