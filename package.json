{
  "name": "arm",
  "private": true,
  "version": "0.0.0",
  "description": "ARM (Agent Resource Management) \u2014 HR-style control plane for AI agents. See docs/arm-spec.md.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "guardrails": "turbo run guardrails",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "postinstall": "turbo run build --filter='./packages/*'"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "2.10.7",
    "typescript": "7.0.2",
    "tsup": "8.5.1",
    "vitest": "4.1.10",
    "eslint": "10.8.0",
    "@types/node": "26.1.1",
    "zod": "4.4.3",
    "typescript-eslint": "8.65.0",
    "husky": "9.1.7",
    "lint-staged": "17.2.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": "prettier --check",
    "*.{json,md,yml,yaml}": "prettier --check"
  }
}
