# Build output and caches
node_modules/
dist/
.next/
.turbo/
out/
coverage/
*.tsbuildinfo

# Lockfile — pnpm owns its formatting
pnpm-lock.yaml

# Vendored agent skills and tooling, kept byte-identical to upstream so
# they can be diffed against it. Not ours to reformat.
.agents/
.claude/
.opencode/

# Generated and binary demo assets
demo/*.mp4
demo/*.png
apps/arm-video/public/
apps/*/*/public/

# Not YAML/XML that prettier can parse, so it can never format these:
# Helm templates are Go text/template that only happens to look like YAML
# ({{ }} where a scalar belongs), and .wxs is WiX XML, for which prettier
# ships no parser. Listing them here is the difference between "we chose
# not to format this" and "format:check is permanently red".
infra/helm/*/templates/
packaging/windows/*.wxs

# drizzle-kit's generated migration metadata. Regenerated verbatim by
# `db:generate`, and the contract-check workflow asserts `git diff --exit-code`
# on this directory — reformatting it would make that check fail on a clean
# tree.
packages/db/drizzle/meta/
